r.x * prevScale;\r\n    const yPrev = canvas.height / 2 + star.y * prevScale;\r\n  \r\n    const { r, g, b } = hexToRgb();\r\n  \r\n    // Draw star trail as a line\r\n    ctx.save();\r\n    ctx.strokeStyle = `rgba(${r}, ${g}, ${b}, 0.7)`;\r\n    ctx.lineWidth = size;\r\n    ctx.shadowBlur = 20;\r\n    ctx.shadowColor = `rgba(${r}, ${g}, ${b}, 0.8)`;\r\n  \r\n    ctx.beginPath();\r\n    ctx.moveTo(x2d, y2d);\r\n    ctx.lineTo(xPrev, yPrev);\r\n    ctx.stroke();\r\n    ctx.restore();\r\n  }\r\n  \r\n  function animate() {\r\n    const canvas = starsCanvas.value;\r\n    if (!canvas) return;\r\n  \r\n    ctx = canvas.getContext(\"2d\");\r\n    if (!ctx) return;\r\n  \r\n    ctx.clearRect(0, 0, canvas.width, canvas.height);\r\n  \r\n    stars.forEach((star) => {\r\n      drawStar(star);\r\n  \r\n      // Move stars toward the viewer (decrease z)\r\n      star.z -= star.speed;\r\n  \r\n      // Reset stars when they get too close\r\n      if (star.z < 1) {\r\n        star.z = canvas.width; // Push back to the far edge\r\n        star.x = (Math.random() - 0.5) * 2 * canvas.width;\r\n        star.y = (Math.random() - 0.5) * 2 * canvas.height;\r\n      }\r\n    });\r\n  \r\n    requestAnimationFrame(animate);\r\n  }\r\n  \r\n  function resizeCanvas() {\r\n    const canvas = starsCanvas.value;\r\n    if (!canvas) return;\r\n  \r\n    canvas.width = canvas.clientWidth;\r\n    canvas.height = canvas.clientHeight;\r\n  }\r\n  </script>\r\n  ","<template>\r\n    <section class=\"bg-white dark:bg-navy-800\">\r\n      <div class=\"container px-6 py-12 mx-auto\">\r\n        <div class=\"grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3\">\r\n          <!-- Philanthropy -->\r\n          <div\r\n            class=\"p-6 bg-gray-50 dark:bg-navy-700 rounded-lg shadow-lg transform transition duration-300 hover:scale-105 hover:shadow-2xl\"\r\n          >\r\n            <!-- Philanthropy Icon -->\r\n            <svg\r\n              class=\"w-12 h-12 mx-auto text-navy-900 dark:text-yell